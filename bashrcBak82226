# 内存拷贝数据及文件拷贝到内存的时间比较
function cPtIme() {
  (mEmtMpfs)
  # pAthDefiNe
  dTiMer=$(date +%S.%N)
  hOmE=/home/giqorg
  DoWfold="${hOmE}"/Downloads
  DoCfold="${hOmE}"/Documents
  TeMfold="${hOmE}"/Templates
  PiCfold="${hOmE}"/Pictures
  PuBfold="${hOmE}"/Public
  ViDfold="${hOmE}"/Videos
  MuSfold="${hOmE}"/Music
  BaSfold="${hOmE}"/.local/state/bash_it
  PiPfold="${TeMfold}"/.PipE
  PWD=$(pwd)
  dictDB="${TeMfold}"/stardict.db
  wordsDB="${TeMfold}"/wordsDict.db
  shareDB=/dev/shm/shAreDaTa"${dTiMer}"
  # baShostry="${hOmE}"/.bash_history
  local stArTime
  local EndTime
  local tOtalTime
  stArTime0=$(date +%s).$(date +%N)
  cp "${DoWfold}"/downloads/Dictionary/stardict.db "${TeMfold}"/stardict"$(date +%S)""$(date +%N)".db
  EndTime0=$(date +%s).$(date +%N)
  tOtalTime0=$(echo "scale=9; ${EndTime0} - ${stArTime0}" | bc)
  echo "本地文件拷贝到内存时间: ${tOtalTime0}=${EndTime0}-${stArTime0}"
  echo '---------------------------------------------------------------------'
  #在内存里的软链接内拷贝数据到内存时间计算
  stArTime1=$(date +%s).$(date +%N)
  cp "${TeMfold}"/giqorg/Downloads/downloads/Dictionary/stardict.db "${TeMfold}"/stardict"$(date +%S)""$(date +%N)".db
  EndTime1=$(date +%s).$(date +%N)
  # sqlite3 -readonly "${dictDB}" <<-SQLITEOF
  #  .headers on
  # .output stdout
  #  SELECT * FROM stardict where sw='$1';
  # SQLITEOF
  # EndTime2=$(date +%s).$(date +%N)
  tOtalTime1=$(echo "scale=9; ${EndTime1} - ${stArTime1}" | bc)
  echo "软链接内数据拷贝到内存时间: ${tOtalTime1}=${EndTime1}-${stArTime1}"
  echo '---------------------------------------------------------------------'
  stArTime2=$(date +%s).$(date +%N)
  cp "${TeMfold}"/stardict.db "${TeMfold}"/stardict"$(date +%S)""$(date +%N)".db
  EndTime2=$(date +%s).$(date +%N)
  tOtalTime2=$(echo "scale=9; ${EndTime2} - ${stArTime2}" | bc)
  echo "内存内拷贝时间tOtalTime: ${tOtalTime2}=${EndTime2}-${stArTime2}"
}


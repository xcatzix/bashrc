# 查找avahi...
function fIndavahi() {
  local sEcpAth=${HOME}/.cache/.sEcUriTypoLicY.log
  # date --rfc-3339=seconds >"${sEcpAth}"
  {
    echo '--------------Avahi stArt-------------'
    find / -name avahi
    echo '--------------Avahi eNd---------------'
    echo "The avahi singing: $(date --rfc-3339=seconds)"
  } >"${sEcpAth}" 2>/dev/null
}

# remove avahi ssh...
function rMavahi() {
  local sEcpAth="${HOME}"/.cache/.sEcUriTypoLicY.log
  while read -r tempLine; do
    if echo "${tempLine}" | grep -E '/'; then
      sudo rm -rf "${tempLine}" && notifyOn=1
    fi
  done <"${sEcpAth}"
  [[ "${notifyOn}" == 1 ]] && notify-send "The avahi singing: 这个房子我准备装修装修来住... "
  notify-send "$(grep 'singing:' ${sEcpAth})"
}

